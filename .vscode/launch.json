{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ManualLauncher",
            "request": "launch",
            "mainClass": "net.rka.ai.ManualLauncher",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "Launcher",
            "request": "launch",
            "mainClass": "net.rka.ai.Launcher",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "JavaRoundTrip",
            "request": "launch",
            "mainClass": "net.rka.ai.tools.code.java.JavaRoundTrip"
        },
        {
            "type": "java",
            "name": "Launcher",
            "request": "launch",
            "mainClass": "net.rka.ai.Launcher",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "Chat UI (JavaFX)",
            "request": "launch",
            "mainClass": "net.rka.ai.ui.Launcher",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "envFile": "${workspaceFolder}/.env",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "CLI",
            "request": "launch",
            "mainClass": "net.rka.ai.cli.Main",
            "args": "${input:question}",
            "envFile": "${workspaceFolder}/.env",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        }
    ],
    "inputs": [
        {
            "id": "question",
            "type": "promptString",
            "description": "Question for the agent",
            "default": "What is today's date, and what is 1234.5 multiplied by 42?"
        }
    ]
}
