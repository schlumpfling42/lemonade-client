{
    // Two configurations of the same app: the Lemonade server in .env, and the one GAIA runs (profile gaia, see README). Run one at a time: both keep their window state and conversations in ~/chat.
    // The launch configurations run the classes that the task "gradle classes" builds (tasks.json), because the editor's own compiler
    // does not run the annotation processor that writes the *Definition classes.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Chat (Lemonade)",
            "request": "launch",
            "mainClass": "net.rka.ai.Launcher",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "Chat (GAIA)",
            "request": "launch",
            "mainClass": "net.rka.ai.Launcher",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "env": { "CHAT_PROFILE": "gaia" },
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "CLI (Lemonade)",
            "request": "launch",
            "mainClass": "net.rka.ai.cli.Main",
            "args": "${input:question}",
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "CLI (GAIA)",
            "request": "launch",
            "mainClass": "net.rka.ai.cli.Main",
            "args": "${input:question}",
            "env": { "CHAT_PROFILE": "gaia" },
            "preLaunchTask": "gradle classes",
            "classPaths": [
                "${workspaceFolder}/build/classes/java/main",
                "${workspaceFolder}/build/resources/main",
                "$Auto"
            ]
        },
        {
            "type": "java",
            "name": "JavaRoundTrip",
            "request": "launch",
            "mainClass": "net.rka.ai.tools.code.java.JavaRoundTrip"
        }
    ],
    "inputs": [
        {
            "id": "question",
            "type": "promptString",
            "description": "Question for the agent",
            "default": "What is today's date, and what is 1234.5 multiplied by 42?"
        }
    ]
}
