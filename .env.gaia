# The profile "gaia": the app uses the Lemonade server that GAIA runs for itself.
# Start it with CHAT_PROFILE=gaia (./gradlew runGaia). The address and the API key of that server change whenever GAIA restarts, so they
# are not written here: the app reads them from ~/.gaia/lemonade/state.json at startup. These values win over .env.
LEMONADE_MODEL=Qwen3.6-35B-A3B-GGUF
# GAIA loads the model with a window of 180,224 tokens shared by 3 slots; the app uses 65,536 of it
MODEL_CONTEXT_TOKENS=65536
MODEL_MAX_OUTPUT_TOKENS=8192
